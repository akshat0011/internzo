node_modules/
*.log
.DS_Store
.vercel

# Secrets. GEMINI_API_KEY lives here so it reaches launchd-spawned runs,
# which get almost no environment of their own.
.env

# Leading slash matters: this is the scraper's local state directory only.
# Without it, web/public/data/jobs.json and web/public/logos — which the site
# needs — would also be ignored, and the deployed site would silently have no
# listings and no logos.
/data/

# Working files: company review lists, regenerated on demand.
skipped-companies.csv
skipped-companies.md

# Vetting working data: judgements about named companies. This repo is public.
vetting/
candidates.json

# Local editor/tooling config. Never published.
.claude/

# Study notes. Kept locally, never published.
book/

# Local SQLite state. Never belongs in the repo.
*.db
*.db-journal
*.db-wal
