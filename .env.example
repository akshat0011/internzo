# Copy to .env and fill in. .env is gitignored.
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override
# GEMINI_MODEL=gemini-2.5-flash

# Telegram channel alerts. Create a bot with @BotFather, then add it as an
# administrator of your channel. The token is a credential - keep it out of git.
TELEGRAM_BOT_TOKEN=
